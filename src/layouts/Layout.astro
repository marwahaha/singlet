---
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/400-italic.css';
import '@fontsource/stix-two-text/600.css';
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import '../styles/essay.css';
import { lastUpdated, lastUpdatedLabel } from '../data/site.mjs';
interface Props {title?:string;description?:string;active?:string;}
const {title='Singlet — Subsystem spin as a primitive for quantum computation',description='A perspective and research agenda curated by Kunal Marwaha and James Sud. Explore subsystem spin, singlet–triplet measurements, and new ways of thinking about quantum computation.',active='essay'}=Astro.props;
const base=import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f7f7f2"/><title>{title}</title><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg?v=antisymmetry`}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><link rel="canonical" href={new URL(Astro.url.pathname,Astro.site)}/><meta property="og:url" content={new URL(Astro.url.pathname,Astro.site)}/></head>
<body>
 <a class="skip-link" href="#main">Skip to content</a>
 <header class="site-header"><a href={base} class="wordmark" aria-label="Singlet home"><img class="singlet-mark" src={base+'singlet-mark.svg'} width="48" height="48" alt=""/><span class="wordmark-name">Singlet</span></a><nav aria-label="Main navigation"><a class:list={{active:active==='essay'}} href={base}>Essay</a><a class:list={{active:active==='experiments'}} href={`${base}experiments/`}>Experiments</a><a class:list={{active:active==='questions'}} href={`${base}questions/`}>Questions</a><a class:list={{active:active==='references'}} href={`${base}references/`}>References</a></nav></header>
 <main id="main"><slot/></main>
 <footer class="site-footer"><a class="footer-title" href={base} aria-label="Singlet home"><span class="footer-brand"><img src={base+'singlet-mark.svg'} width="64" height="64" alt=""/>Singlet</span><span>Subsystem spin as a primitive<br/>for quantum computation.</span></a><div><p>A perspective and research agenda<br/>Curated by Kunal Marwaha and James Sud · 2026</p><a href={`${base}references/#acknowledgments`}>About this work ↗</a></div><div><a href={`${base}questions/`}>Research questions ↗</a><a href={`${base}references/`}>Sources & acknowledgments ↗</a><span class="footer-small">Last updated <time datetime={lastUpdated}>{lastUpdatedLabel}</time></span></div></footer>
</body></html>
