---
import Layout from '../../layouts/Layout.astro';
import Discussion from '../../components/Discussion.astro';
import { questionDiscussions, proposeQuestionUrl } from '../../data/discussions.mjs';
import MathText from '../../components/MathText.astro';
import {mathTextToPlainText} from '../../lib/math-text.mjs';
import QuestionLink from '../../components/QuestionLink.astro';
import questions from '../../data/questions.json';
import references from '../../data/references.json';
import {categories} from '../../data/categories.mjs';
export function getStaticPaths(){return questions.map(q=>({params:{id:q.id.toLowerCase()},props:{q}}));}
const {q}=Astro.props;const refs=references.filter(r=>q.references.includes(r.key));const related=questions.filter(x=>x.category===q.category&&x.id!==q.id).slice(0,2);const index=questions.findIndex(x=>x.id===q.id);const base=import.meta.env.BASE_URL;
---
<Layout title={`${q.id}: ${mathTextToPlainText(q.title)} — Singlet`} description={mathTextToPlainText(q.summary)} active="questions"><article><header class="page-heading question-heading"><a class="back-link" href={`${base}questions/`}>← All research questions</a><div class="eyebrow">{q.id} / {categories[q.category]} / {q.kind}</div><h1 aria-label={mathTextToPlainText(q.title)}><MathText text={q.title}/></h1><p><MathText text={q.summary}/></p><a class="text-link" href="#discussion">Discuss this question <span aria-hidden="true">↓</span></a></header><div class="question-body"><aside><span class="eyebrow">Working formulation</span><dl><dt>Family</dt><dd>{categories[q.category]}</dd><dt>Version</dt><dd>17 September 2026</dd></dl><a href={`${base}questions.json`} download>Download the catalog ↗</a><p><a href={`${base}questions/#conventions`}>Model and error conventions</a></p></aside><div class="prose"><section class="formal-statement"><div class="eyebrow">{q.kind==='conjecture'?'The conjecture':q.kind==='hypothesis'?'The guiding hypothesis':'Working mathematical formulation'}</div><p><MathText text={q.preciseStatement}/></p></section>{q.scopeNote&&<div class="scope-note"><strong>Scope & assumptions</strong><p><MathText text={q.scopeNote}/></p></div>}<h2>Why this is interesting</h2><p><MathText text={q.why}/></p>{q.knownResult&&<aside class="known-result"><div class="eyebrow">Established starting point</div><p><MathText text={q.knownResult}/></p></aside>}{q.variants&&<section class="question-variants"><h2>Explicit variants</h2><ol class="formulation-variants">{q.variants.map(v=><li><h3><MathText text={v.label}/></h3><p><MathText text={v.statement}/></p></li>)}</ol></section>}<h2>A place to start</h2><p><MathText text={q.firstStep}/></p><h2>Related work</h2><p class="fine-print">These works provide context and established results. They need not be the origin of this exact formulation.</p><ol class="related-references">{refs.map(r=><li><a href={r.url}>{r.title} <span>↗</span></a><p>{r.authors.replaceAll(';',',')} · {r.year}</p><a class="reference-note-link" href={`${base}references/#${r.key}`}>Read the relevance note</a></li>)}</ol>{related.length>0&&<section class="related-questions"><h2>Related questions</h2>{related.map(r=><QuestionLink id={r.id}/>)}</section>}{questionDiscussions[q.id] ? <Discussion number={questionDiscussions[q.id]} title="Discuss this question" invitation="Possible reductions, counterexamples, special cases, and related results are welcome."/> : <p class="question-contribution"><a href={proposeQuestionUrl}>Propose a related research question ↗</a></p>}</div></div><nav class="question-pagination" aria-label="Question pagination">{index>0?<a href={`${base}questions/${questions[index-1].id.toLowerCase()}/`}>← {questions[index-1].id} / Previous question</a>:<span/>}{index<questions.length-1?<a href={`${base}questions/${questions[index+1].id.toLowerCase()}/`}>{questions[index+1].id} / Next question →</a>:<span/>}</nav></article></Layout>
