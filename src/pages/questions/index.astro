---
import Layout from '../../layouts/Layout.astro';
import { proposeQuestionUrl } from '../../data/discussions.mjs';
import MathText from '../../components/MathText.astro';
import {mathTextToPlainText} from '../../lib/math-text.mjs';
import questions from '../../data/questions.json';
import {categories} from '../../data/categories.mjs';
---
<Layout title="The research questions — Singlet" active="questions"><header class="page-heading"><div class="eyebrow">{questions.length} questions / 8 areas</div><h1>Research questions</h1><p>These are questions that arose while thinking about subsystem spin. I have tried to state the assumptions explicitly and give each question a starting point; some formulations will surely need revision.</p><p class="fine-print">These are working formulations, including two named literature conjectures. Sources document connections and antecedents; inclusion is not a claim of novelty or a complete prior-art audit.</p><aside class="question-invitation"><a class="text-link" href={proposeQuestionUrl}>Propose a research question <span aria-hidden="true">↗</span></a><p>A tentative formulation is welcome. The form opens a discussion on GitHub; no code or pull request is needed. Posting requires a GitHub account.</p></aside></header><section class="model-conventions" id="conventions"><details><summary>Conventions for the working formulations</summary><div class="details-body"><p>Unless a question says otherwise, the input is classical, the controller is uniform and runs in polynomial time, the quantum input is maximally mixed, and every pair measurement is an ideal singlet–triplet projection (STP): the measured qubits are kept, and coherence within the singlet or triplet subspace is preserved. An ancilla-based SWAP test implements this measurement. All ancillary qubits and failed attempts count toward the stated cost. A closed-register statement permits no fresh qubits or discarding.</p><p>Decision protocols use a <MathText text="$2/3$ versus $1/3$"/> acceptance gap. Sampling error means total variation distance; state-preparation error means trace distance. Coherent encoded-channel simulation is stronger and uses diamond distance, including an external reference.</p></div></details></section><section class="atlas" aria-label="Research question catalog"><form class="atlas-controls" role="search"><div><label for="question-search">Search the questions</label><input id="question-search" type="search" placeholder="Try antisymmetry, Shor, purification…" autocomplete="off"/></div><div><label for="question-kind">Type of question</label><select id="question-kind"><option value="all">All types</option><option value="question">Questions</option><option value="direction">Research directions</option><option value="conjecture">Named conjectures</option><option value="hypothesis">Guiding hypotheses</option></select></div></form><div class="category-filters" role="group" aria-label="Filter by research family"><button data-category="all" aria-pressed="true">All <span>{questions.length}</span></button>{Object.entries(categories).map(([key,label])=><button data-category={key} aria-pressed="false">{label}<span>{questions.filter(q=>q.category===key).length}</span></button>)}</div><div class="atlas-status"><span data-results-count role="status" aria-live="polite">{questions.length} questions</span><button class="quiet-button" data-clear-filters>Reset filters ↺</button><a href={`${import.meta.env.BASE_URL}questions.json`} download>Download JSON ↗</a></div><div class="question-list">{questions.map(q=><a aria-label={`${q.id}: ${mathTextToPlainText(q.title)}`} data-question-title={mathTextToPlainText(q.title)} class="question-row" href={`${import.meta.env.BASE_URL}questions/${q.id.toLowerCase()}/`} data-question-row data-category={q.category} data-kind={q.kind} data-search={`${q.id} ${q.title} ${q.summary} ${q.tags.join(' ')} ${q.preciseStatement} ${JSON.stringify(q.variants||[])} ${q.knownResult||''} ${[q.title,q.summary,q.preciseStatement,q.knownResult||'',...(q.variants||[]).map(v=>v.statement)].map(mathTextToPlainText).join(' ')}`.toLowerCase()}><div class="question-code">{q.id}<span>{q.kind}</span></div><div><div class="eyebrow">{categories[q.category]}</div><h2 aria-label={mathTextToPlainText(q.title)}><MathText text={q.title}/></h2><p><MathText text={q.summary}/></p><div class="question-tags">{q.tags.slice(0,3).map(t=><span>{t}</span>)}</div></div><span class="question-arrow" aria-hidden="true">↗</span></a>)}</div><div class="empty-state" data-empty hidden><h2>No questions match.</h2><p>Try a broader term or reset the filters to see all the questions.</p><button class="text-link" data-clear-filters>Show all questions <span>↗</span></button></div><noscript><p class="no-script">Search and filters need JavaScript. All {questions.length} questions are listed above and their pages work without it.</p></noscript><div class="catalog-contribution"><a class="text-link" href={proposeQuestionUrl}>Propose a research question <span aria-hidden="true">↗</span></a></div></section></Layout>
<script>
import {registerPageTool} from '../../scripts/webmcp.mjs';
const search=document.querySelector<HTMLInputElement>('#question-search')!,kind=document.querySelector<HTMLSelectElement>('#question-kind')!;let category='all';
const validCategories=new Set(Array.from(document.querySelectorAll<HTMLButtonElement>('.category-filters button')).map(b=>b.dataset.category));
const params=new URLSearchParams(location.search);search.value=params.get('q')||'';if(validCategories.has(params.get('category')||''))category=params.get('category')!;if(['question','direction','conjecture','hypothesis'].includes(params.get('kind')||''))kind.value=params.get('kind')!;
function filter(){let count=0;const term=search.value.trim().toLowerCase();document.querySelectorAll<HTMLElement>('[data-question-row]').forEach(row=>{const visible=(category==='all'||row.dataset.category===category)&&(kind.value==='all'||row.dataset.kind===kind.value)&&row.dataset.search!.includes(term);row.hidden=!visible;if(visible)count++;});document.querySelector('[data-results-count]')!.textContent=`${count} ${count===1?'question':'questions'}`;document.querySelector<HTMLElement>('[data-empty]')!.hidden=count!==0;document.querySelectorAll<HTMLButtonElement>('.category-filters button').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.category===category)));const p=new URLSearchParams();if(term)p.set('q',search.value);if(category!=='all')p.set('category',category);if(kind.value!=='all')p.set('kind',kind.value);history.replaceState(null,'',location.pathname+(p.size?'?'+p.toString():''));}
document.querySelector('form')!.addEventListener('submit',e=>e.preventDefault());search.addEventListener('input',filter);kind.addEventListener('change',filter);document.querySelectorAll<HTMLButtonElement>('.category-filters button').forEach(b=>b.addEventListener('click',()=>{category=b.dataset.category!;filter();}));document.querySelectorAll('[data-clear-filters]').forEach(b=>b.addEventListener('click',()=>{category='all';search.value='';kind.value='all';filter();}));filter();
registerPageTool({name:'filter_research_questions',title:'Filter the research questions',description:'Update the visible research-question atlas and return the matching question titles and links. Omitted filters reset to all questions.',inputSchema:{type:'object',properties:{query:{type:'string'},category:{type:'string',enum:Array.from(validCategories)},kind:{type:'string',enum:['all','question','direction','conjecture','hypothesis']}},additionalProperties:false},annotations:{readOnlyHint:false,untrustedContentHint:false},execute(input:unknown){if(!input||typeof input!=='object'||Array.isArray(input))throw new Error('Expected a filter object.');const x=input as Record<string,unknown>;if(Object.keys(x).some(k=>!['query','category','kind'].includes(k))||(x.query!==undefined&&typeof x.query!=='string')||(x.category!==undefined&&!validCategories.has(x.category as string))||(x.kind!==undefined&&!['all','question','direction','conjecture','hypothesis'].includes(x.kind as string)))throw new Error('Invalid atlas filters.');search.value=(x.query as string)||'';category=(x.category as string)||'all';kind.value=(x.kind as string)||'all';filter();return Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-question-row]:not([hidden])')).map(row=>({title:row.dataset.questionTitle,url:row.href}));}});
</script>
